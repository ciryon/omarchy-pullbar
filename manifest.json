{
  "schemaVersion": 1,
  "id": "io.github.ciryon.pullbar",
  "name": "Pull requests",
  "version": "0.1.0",
  "author": "ciryon",
  "license": "MIT",
  "description": "Open GitHub pull requests waiting on you: review requests, assigned, and your own, in the Omarchy bar.",
  "kinds": ["bar-widget"],
  "entryPoints": { "barWidget": "Panel.qml" },
  "barWidget": {
    "displayName": "Pull requests",
    "description": "Counts review requests in the bar; the popup lists review requests, assigned and authored PRs. Click one to open it.",
    "category": "Development",
    "aliases": ["pr", "pull request", "github", "review"],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": { "refreshIntervalSec": 300, "maxPerSection": 10 },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 60,
        "max": 3600,
        "step": 30,
        "defaultValue": 300
      },
      {
        "key": "maxPerSection",
        "type": "integer",
        "label": "Pull requests per section",
        "min": 3,
        "max": 30,
        "step": 1,
        "defaultValue": 10
      }
    ]
  }
}
